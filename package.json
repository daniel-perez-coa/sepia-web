{
  "name": "sepia-chroma-street",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:seed:local": "node scripts/seed-local.mjs",
    "db:setup:local": "node scripts/setup-local-db.mjs"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.2",
    "@openai/sites-vite-plugin": "0.2.0",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "sass": "^1.90.0",
    "vite": "8.2.2",
    "wrangler": "4.127.1"
  },
  "dependencies": {
    "bootstrap-icons": "^1.13.1"
  }
}

{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sepia-chroma-street-2026",
  "main": "./worker.js",
  "compatibility_date": "2026-08-31",
  "secrets": {
    "required": ["ADMIN_USER_EMAILS", "LOCAL_DEV_AUTH"]
  },
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sepia-catalog",
      "database_id": "b6babd5e-95f4-40bb-a5f5-db34c8cfa37f",
      "migrations_dir": "drizzle"
    }
  ]
}
